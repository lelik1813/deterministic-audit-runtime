{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.inner-agent-state.local/candidate.schema.json",
  "title": "Candidate Entities",
  "description": "Non-authoritative candidate entities for the v1.2 candidate layer. Candidates are proposals subject to validation and are NOT part of canonical truth.",
  "type": "object",
  "$defs": {
    "candidateId": {
      "type": "string",
      "pattern": "^candidate_[a-z0-9][a-z0-9_-]*$"
    },
    "candidateType": {
      "type": "string",
      "enum": [
        "risk_candidate",
        "policy_candidate",
        "cross_file_correlation",
        "verification_target"
      ]
    },
    "candidateStatus": {
      "type": "string",
      "enum": [
        "proposed",
        "routed_to_verify",
        "rejected",
        "resolved_promoted"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "observationId": {
      "type": "string",
      "pattern": "^obs_[a-z0-9][a-z0-9_-]*$",
      "description": "Reference to a canonical observation (upstream evidence)"
    },
    "supportingEvidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "description": "A preliminary evidence reference linking candidate to source code. Not equivalent to observation.provenance.source_refs.",
      "required": [
        "file_path",
        "line_range",
        "snapshot_ref"
      ],
      "properties": {
        "file_path": {
          "type": "string",
          "minLength": 1
        },
        "line_range": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "type": "integer",
              "minimum": 1
            },
            "end": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "snapshot_ref": {
          "type": "string",
          "minLength": 1
        },
        "file_hash": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{7,128}$"
        },
        "excerpt": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "verificationTargetRef": {
      "type": "object",
      "additionalProperties": false,
      "description": "Target entity that this verification_target candidate proposes to verify. Only upstream evidence types allowed.",
      "required": [
        "target_type",
        "target_id"
      ],
      "properties": {
        "target_type": {
          "type": "string",
          "enum": [
            "observation",
            "hypothesis",
            "candidate"
          ],
          "description": "Only upstream evidence types. NOT task, issue, or decision."
        },
        "target_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "candidateBase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "candidate_type",
        "audit_id",
        "proposed_claim",
        "confidence",
        "supporting_evidence_refs",
        "reasoning_basis",
        "status",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "candidate_id": {
          "$ref": "#/$defs/candidateId"
        },
        "candidate_type": {
          "$ref": "#/$defs/candidateType"
        },
        "audit_id": {
          "type": "string",
          "pattern": "^audit_[a-z0-9][a-z0-9_-]*$"
        },
        "proposed_claim": {
          "type": "string",
          "minLength": 1,
          "description": "The assertion being proposed. Not equivalent to observation.statement. Requires verification before becoming a truth-bearing claim."
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "supporting_evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/supportingEvidenceRef"
          },
          "minItems": 1,
          "uniqueItems": true,
          "description": "Preliminary evidence references. Not equivalent to observation.provenance.source_refs."
        },
        "reasoning_basis": {
          "type": "string",
          "minLength": 1,
          "description": "Explanation of why this candidate was generated"
        },
        "status": {
          "$ref": "#/$defs/candidateStatus"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "riskCandidate": {
      "type": "object",
      "description": "A candidate representing a potential security risk or vulnerability pattern. May reference upstream observations that triggered this risk hypothesis.",
      "allOf": [
        {
          "$ref": "#/$defs/candidateBase"
        },
        {
          "type": "object",
          "properties": {
            "candidate_type": {
              "const": "risk_candidate"
            },
            "risk_category": {
              "type": "string",
              "enum": [
                "injection",
                "authentication",
                "access_control",
                "cryptography",
                "data_exposure",
                "configuration",
                "dependency",
                "other"
              ]
            },
            "severity_hint": {
              "type": "string",
              "enum": [
                "informational",
                "low",
                "medium",
                "high",
                "critical"
              ],
              "description": "Preliminary severity hint for routing decisions. Not equivalent to issue.severity. Requires verification before use in findings."
            },
            "trigger_observation_ids": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/observationId"
              },
              "uniqueItems": true,
              "description": "Canonical observations that triggered this risk candidate. Upstream evidence only."
            }
          },
          "required": [
            "risk_category"
          ]
        }
      ]
    },
    "policyCandidate": {
      "type": "object",
      "description": "A candidate representing a potential violation of audit policy rules. May reference upstream observations that triggered this policy violation hypothesis.",
      "allOf": [
        {
          "$ref": "#/$defs/candidateBase"
        },
        {
          "type": "object",
          "properties": {
            "candidate_type": {
              "const": "policy_candidate"
            },
            "policy_rule_ref": {
              "type": "string",
              "minLength": 1,
              "description": "Reference to the policy rule this candidate may violate"
            },
            "policy_category": {
              "type": "string",
              "enum": [
                "security_baseline",
                "compliance_requirement",
                "coding_standard",
                "architectural_constraint",
                "other"
              ]
            },
            "trigger_observation_ids": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/observationId"
              },
              "uniqueItems": true,
              "description": "Canonical observations that triggered this policy candidate. Upstream evidence only."
            }
          },
          "required": [
            "policy_rule_ref"
          ]
        }
      ]
    },
    "crossFileCorrelation": {
      "type": "object",
      "description": "A candidate representing a detected correlation or relationship across multiple files. May reference upstream observations from involved files.",
      "allOf": [
        {
          "$ref": "#/$defs/candidateBase"
        },
        {
          "type": "object",
          "properties": {
            "candidate_type": {
              "const": "cross_file_correlation"
            },
            "relationship_type": {
              "type": "string",
              "enum": [
                "data_flow",
                "control_flow",
                "dependency",
                "configuration_link",
                "api_contract",
                "other"
              ]
            },
            "involved_file_paths": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 2,
              "uniqueItems": true,
              "description": "Paths to all files involved in this cross-file hypothesis"
            },
            "related_observation_ids": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/observationId"
              },
              "uniqueItems": true,
              "description": "Canonical observations from the involved files that support this hypothesis. Upstream evidence only."
            }
          },
          "required": [
            "relationship_type",
            "involved_file_paths"
          ]
        }
      ]
    },
    "verificationTargetCandidate": {
      "type": "object",
      "description": "A candidate proposing that a specific claim or pattern requires verification. NOT a task - this is a non-authoritative proposal that may influence routing.",
      "allOf": [
        {
          "$ref": "#/$defs/candidateBase"
        },
        {
          "type": "object",
          "properties": {
            "candidate_type": {
              "const": "verification_target"
            },
            "verification_target": {
              "$ref": "#/$defs/verificationTargetRef"
            },
            "verification_questions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "description": "Questions that need to be answered to verify the target"
            },
            "trigger_observation_ids": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/observationId"
              },
              "uniqueItems": true,
              "description": "Canonical observations that suggest verification is needed. Upstream evidence only."
            }
          },
          "required": [
            "verification_target"
          ]
        }
      ]
    },
    "candidate": {
      "oneOf": [
        {
          "$ref": "#/$defs/riskCandidate"
        },
        {
          "$ref": "#/$defs/policyCandidate"
        },
        {
          "$ref": "#/$defs/crossFileCorrelation"
        },
        {
          "$ref": "#/$defs/verificationTargetCandidate"
        }
      ]
    },
    "candidateCollection": {
      "type": "object",
      "propertyNames": {
        "pattern": "^candidate_[a-z0-9][a-z0-9_-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/candidate"
      }
    }
  }
}
