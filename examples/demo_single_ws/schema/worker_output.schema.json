{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.inner-agent-state.local/worker_output.schema.json",
  "title": "Worker Output Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "slice_id",
    "worker_role",
    "task_id",
    "candidate_events"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "slice_id": {
      "$ref": "#/$defs/sliceId"
    },
    "worker_role": {
      "$ref": "https://schemas.inner-agent-state.local/audit.schema.json#/$defs/workerRole"
    },
    "task_id": {
      "$ref": "https://schemas.inner-agent-state.local/audit.schema.json#/$defs/taskId"
    },
    "candidate_events": {
      "type": "array",
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "worker_role": {
            "const": "Reader"
          }
        }
      },
      "then": {
        "properties": {
          "candidate_events": {
            "items": {
              "$ref": "#/$defs/readerCandidateEvent"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "worker_role": {
            "const": "Verifier"
          }
        }
      },
      "then": {
        "properties": {
          "candidate_events": {
            "items": {
              "$ref": "#/$defs/verifierCandidateEvent"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "worker_role": {
            "const": "IssueComposer"
          }
        }
      },
      "then": {
        "properties": {
          "candidate_events": {
            "items": {
              "$ref": "#/$defs/issueComposerCandidateEvent"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "worker_role": {
            "const": "CandidateGenerator"
          }
        }
      },
      "then": {
        "properties": {
          "candidate_events": {
            "items": {
              "$ref": "#/$defs/candidateGeneratorCandidateEvent"
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sliceId": {
      "type": "string",
      "pattern": "^slice_[a-f0-9]{16}$"
    },
    "pendingAcceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "decided_at",
        "decided_by",
        "reason"
      ],
      "properties": {
        "status": {
          "const": "pending"
        },
        "decided_at": {
          "type": "null"
        },
        "decided_by": {
          "type": "null"
        },
        "reason": {
          "type": "null"
        }
      }
    },
    "candidateEventBase": {
      "allOf": [
        {
          "$ref": "https://schemas.inner-agent-state.local/event.schema.json"
        },
        {
          "properties": {
            "actor": {
              "type": "object",
              "properties": {
                "actor_type": {
                  "const": "worker"
                }
              },
              "required": [
                "actor_type",
                "actor_id",
                "role"
              ]
            },
            "snapshot_ref": {
              "$ref": "https://schemas.inner-agent-state.local/audit.schema.json#/$defs/snapshotRef"
            },
            "acceptance": {
              "$ref": "#/$defs/pendingAcceptance"
            }
          }
        }
      ]
    },
    "readerCandidateEvent": {
      "allOf": [
        {
          "$ref": "#/$defs/candidateEventBase"
        },
        {
          "properties": {
            "event_type": {
              "enum": [
                "observation.proposed",
                "hypothesis.proposed",
                "question.opened"
              ]
            },
            "actor": {
              "properties": {
                "role": {
                  "const": "Reader"
                }
              }
            }
          }
        }
      ]
    },
    "verifierCandidateEvent": {
      "allOf": [
        {
          "$ref": "#/$defs/candidateEventBase"
        },
        {
          "properties": {
            "event_type": {
              "enum": [
                "observation.verified",
                "observation.rejected",
                "contradiction.registered",
                "question.opened"
              ]
            },
            "actor": {
              "properties": {
                "role": {
                  "const": "Verifier"
                }
              }
            }
          }
        }
      ]
    },
    "issueComposerCandidateEvent": {
      "allOf": [
        {
          "$ref": "#/$defs/candidateEventBase"
        },
        {
          "properties": {
            "event_type": {
              "enum": [
                "issue.proposed"
              ]
            },
            "actor": {
              "properties": {
                "role": {
                  "const": "IssueComposer"
                }
              }
            }
          }
        }
      ]
    },
    "candidateGeneratorCandidateEvent": {
      "allOf": [
        {
          "$ref": "#/$defs/candidateEventBase"
        },
        {
          "properties": {
            "event_type": {
              "enum": [
                "candidate.proposed"
              ]
            },
            "entity_type": {
              "const": "candidate"
            },
            "actor": {
              "properties": {
                "role": {
                  "const": "CandidateGenerator"
                }
              }
            },
            "payload": {
              "$ref": "https://schemas.inner-agent-state.local/audit.schema.json#/$defs/candidate"
            }
          }
        }
      ]
    }
  }
}
