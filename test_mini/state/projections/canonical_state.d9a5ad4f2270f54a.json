      },
      "id": "issue_3768d5377639b1a7",
      "severity": null,
      "severity_rule_ref": null,
      "status": "proposed",
      "summary": "`app.py` configures Flask-CORS with `origins: \"*\"` for all routes, which permits any website origin to make cross-origin requests to this service. This overly broad policy increases exposure to unintended cross-origin access and should be constrained to trusted origins.",
      "title": "CORS policy allows all origins",
      "updated_at": "2026-03-31T10:25:26Z"
    },
    "issue_4a56f6e18d1d7f17": {
      "audit_id": "audit_test_mini",
      "created_at": "2026-03-31T10:24:55Z",
      "evidence": {
        "observation_ids": [
          "obs_0d7c26d7ca74f696"
        ]
      },
      "id": "issue_4a56f6e18d1d7f17",
      "severity": "high",
      "severity_rule_ref": "SECURITY.SQL_INJECTION.PARAMETERIZATION_REQUIRED",
      "status": "proposed",
      "summary": "The SQL statement in app.py is built by interpolating `uid` directly into the query string before execution. If `uid` is user-controllable, this pattern can enable SQL injection. Use parameterized queries instead of string interpolation.",
      "title": "Potential SQL injection via f-string query construction",
      "updated_at": "2026-03-31T10:24:55Z"
    },
    "issue_7d6afa1c512a7dd1": {
