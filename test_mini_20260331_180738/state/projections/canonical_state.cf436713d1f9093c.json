        ]
      },
      "id": "issue_7793395f77f3b316",
      "severity": "high",
      "severity_rule_ref": "CWE-327",
      "status": "proposed",
      "summary": "Password hashing in app.py uses hashlib.md5(...).hexdigest(), which is cryptographically broken and allows fast offline cracking of password hashes if they are exposed. Use a password-specific slow hash (for example Argon2id, scrypt, or bcrypt) with a per-password salt.",
      "title": "Insecure password hashing uses MD5",
      "updated_at": "2026-03-31T16:28:28Z"
    },
    "issue_7c2041c1ce6e8797": {
      "audit_id": "audit_test_mini",
