      "id": "issue_07592a76e2d97adb",
      "severity": "high",
      "severity_rule_ref": "security.assert_used_for_enforcement",
      "status": "proposed",
      "summary": "`app.py` uses `assert DEBUG, \"not in debug mode\"` for a security-relevant control. In Python optimized mode (e.g., `-O`), assertions are stripped, which removes this check and can allow execution without the intended protection.",
      "title": "Security check implemented with assert can be bypassed in optimized runtime",
      "updated_at": "2026-03-31T16:25:04Z"
    },
    "issue_1bd68fdae80a9745": {
      "audit_id": "audit_test_mini",
      "created_at": "2026-03-31T16:24:50Z",
      "evidence": {
        "observation_ids": [
          "obs_79623f78cb346bbd"
        ]
      },
      "id": "issue_1bd68fdae80a9745",
      "severity": null,
      "severity_rule_ref": null,
      "status": "proposed",
      "summary": "`app.py` decodes JWTs with `verify_signature` set to `False`, which allows attackers to forge arbitrary tokens that will be accepted as valid. This can enable authentication and authorization bypass wherever decoded token claims are trusted.",
      "title": "JWT signature verification is disabled during token decoding",
      "updated_at": "2026-03-31T16:24:50Z"
    },
    "issue_229c8cc272ad5a72": {
      "audit_id": "audit_test_mini",
      "created_at": "2026-03-31T16:25:36Z",
      "evidence": {
        "observation_ids": [
          "obs_a2f3686406f8032f"
        ]
      },
      "id": "issue_229c8cc272ad5a72",
      "severity": null,
      "severity_rule_ref": null,
      "status": "proposed",
      "summary": "Security code generation uses Python's non-cryptographic PRNG via random.randint(100000, 999999) in app.py. This can make generated verification codes more predictable than cryptographically secure randomness, weakening the security of code-based verification.",
      "title": "Insecure security-code generation uses non-cryptographic PRNG",
      "updated_at": "2026-03-31T16:25:36Z"
    },
    "issue_2f32af659b94f83a": {
      "audit_id": "audit_test_mini",
      "created_at": "2026-03-31T16:23:49Z",
      "evidence": {
        "observation_ids": [
