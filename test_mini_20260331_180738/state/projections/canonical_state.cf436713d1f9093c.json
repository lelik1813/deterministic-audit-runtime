        ]
      },
      "id": "issue_2f32af659b94f83a",
      "severity": null,
      "severity_rule_ref": null,
      "status": "proposed",
      "summary": "A route in app.py is explicitly decorated with @csrf_exempt, which disables CSRF validation for that endpoint. This can allow cross-site request forgery against authenticated users when cookie-based authentication is in use.",
      "title": "CSRF protection disabled on application route",
      "updated_at": "2026-03-31T16:23:49Z"
    },
    "issue_7793395f77f3b316": {
      "audit_id": "audit_test_mini",
      "created_at": "2026-03-31T16:28:28Z",
      "evidence": {
        "observation_ids": [
