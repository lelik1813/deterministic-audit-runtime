      "id": "issue_9d9a7eed83555ce7",
      "severity": "high",
      "severity_rule_ref": "SEC.SQLI.001",
      "status": "proposed",
      "summary": "`app.py` builds a SQL statement with Python `format()` using the `role` parameter (`SELECT * FROM users WHERE role = '{}'`). This is a direct code-level SQL injection risk because untrusted input is interpolated into SQL text instead of being parameterized.",
      "title": "SQL injection via string-formatted role filter in user query",
      "updated_at": "2026-03-31T16:24:19Z"
    },
    "issue_ab30b9af8a558cb6": {
      "audit_id": "audit_test_mini",
      "created_at": "2026-03-31T16:25:20Z",
      "evidence": {
        "observation_ids": [
          "obs_7fd37fd2e70647b1"
        ]
      },
      "id": "issue_ab30b9af8a558cb6",
      "severity": null,
      "severity_rule_ref": null,
      "status": "proposed",
      "summary": "`app.py` constructs tokens by base64-encoding the user id (`return base64.b64encode(str(uid).encode()).decode()`), which is reversible and provides no signature or encryption. An attacker can forge tokens for arbitrary user IDs, enabling authentication bypass/impersonation if this token is trusted for identity.",
      "title": "Unsigned reversible token allows account impersonation",
      "updated_at": "2026-03-31T16:25:20Z"
    },
