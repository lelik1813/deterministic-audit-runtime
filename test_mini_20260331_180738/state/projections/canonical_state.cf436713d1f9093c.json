      "severity": "high",
      "severity_rule_ref": "sensitive-data-exposure:secret-key-in-response",
      "status": "proposed",
      "summary": "A debug endpoint in app.py returns SECRET_KEY directly in the HTTP JSON response (`{\"key\": SECRET_KEY}`), exposing sensitive secret material to callers and creating a direct secret-disclosure risk.",
